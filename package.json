{
  "name": "scoped",
  "version": "0.3.0",
  "description": "MCP coordination layer for concurrent Claude Code fleets — file-level claim/release/check locking backed by local SQLite, with optional async Linear visibility.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OrenSegal/scoped.git"
  },
  "homepage": "https://github.com/OrenSegal/scoped#readme",
  "bugs": {
    "url": "https://github.com/OrenSegal/scoped/issues"
  },
  "bin": {
    "scoped": "./src/index.mjs"
  },
  "main": "src/index.mjs",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node src/index.mjs",
    "dev": "node --watch src/index.mjs",
    "setup": "node scripts/install.mjs",
    "uninstall": "node scripts/uninstall.mjs",
    "test": "node --test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.24.0"
  },
  "license": "MIT"
}
