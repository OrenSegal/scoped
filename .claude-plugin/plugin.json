  "keywords": ["concurrency", "locking", "hooks", "mcp", "worktrees", "claude-code"],
  "mcpServers": {
    "scoped": { "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/bin/scoped-mcp"] }
  }
}
